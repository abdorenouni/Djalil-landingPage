# ── Sanity CMS ──────────────────────────────────────────────────
VITE_SANITY_PROJECT_ID=   # Sanity project ID (from sanity.io/manage)
VITE_SANITY_DATASET=production

# ── Contact form email relay (optional) ─────────────────────────
# Google Apps Script web-app URL that emails contact-form leads to the agency.
# See google-apps-script/Code.gs for the 5-minute setup. If left empty, the
# form falls back to opening a pre-filled WhatsApp message instead.
VITE_CONTACT_ENDPOINT=    # e.g. https://script.google.com/macros/s/AKfyc.../exec

# ── Laravel backend (réunions Zoom) ─────────────────────────────
# Origin of the elite-backend API. Empty = same origin (reverse proxy).
VITE_BACKEND_URL=http://localhost:8000
