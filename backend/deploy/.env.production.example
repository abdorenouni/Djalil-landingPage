# ─────────────────────────────────────────────────────────────────────
# Elite Backend — .env de PRODUCTION (modèle)
# Copier vers /var/www/elite-backend/.env puis compléter chaque champ.
# Générer la clé après copie :  php artisan key:generate
# ─────────────────────────────────────────────────────────────────────

APP_NAME="Elite Promotion"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.elite-promotion.dz

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ── PostgreSQL ────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=elite_backend
DB_USERNAME=elite
DB_PASSWORD=

# ── Sessions / auth (Sanctum SPA) ────────────────────────────────────
# SESSION_DOMAIN : domaine parent commun si le front et l'API partagent
# un domaine (ex. .elite-promotion.dz). SANCTUM_STATEFUL_DOMAINS : hôte(s)
# du front autorisés à s'authentifier par cookie de session.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.elite-promotion.dz
SANCTUM_STATEFUL_DOMAINS=elite-promotion.dz,www.elite-promotion.dz

# Origine du site public (CORS).
FRONTEND_URL=https://elite-promotion.dz

# ── Files d'attente + cache ──────────────────────────────────────────
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Diffusion temps réel (Reverb) ────────────────────────────────────
# Générer trois valeurs aléatoires (ex. : openssl rand -hex 16).
# REVERB_HOST = domaine public ; nginx proxifie /app/ vers 127.0.0.1:8080.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=api.elite-promotion.dz
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# ── Email (notifications + confirmations clients) ────────────────────
# Vérifié fonctionnel : compte Gmail réel, testé de bout en bout.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="mar.elitee@gmail.com"
# Mot de passe d'application Gmail (pas le mot de passe du compte) — à
# régénérer sur myaccount.google.com/apppasswords si besoin de le changer.
MAIL_PASSWORD="yvplfcdxpczvhslt"
MAIL_FROM_ADDRESS="mar.elitee@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Fonctionnel ──────────────────────────────────────────────────────
# Email de confirmation au client après acceptation (true/false).
MEETING_REQUESTS_NOTIFY_CUSTOMER=true
# Limite du formulaire public (soumissions/minute/IP).
MEETING_REQUESTS_RATE_LIMIT=5

# ── Zoom (optionnel) ──────────────────────────────────────────────────
# Vérifié fonctionnel : app Server-to-Server OAuth réelle, testée de
# bout en bout (réunion créée et liée automatiquement à l'acceptation).
ZOOM_ACCOUNT_ID=EM6jkNEwQA-rF9nN-Uy6dQ
ZOOM_CLIENT_ID=D47LSgncRDCfn9yjDqV9RA
ZOOM_CLIENT_SECRET=HRRM3eOAuMXMuclDbvmEiYKJ7Kz8p2Qm

# ── Odoo (optionnel) — synchronisation CRM ───────────────────────────
# Désactivé par défaut. Voir DEPLOYMENT.md §11 avant d'activer.
ODOO_ENABLED=false
ODOO_URL=
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_API_KEY=
