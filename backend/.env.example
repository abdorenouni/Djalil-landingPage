APP_NAME="Elite Promotion"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=elite_backend
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# First-party origins allowed to authenticate with session cookies (Sanctum SPA).
SANCTUM_STATEFUL_DOMAINS=localhost:8000,localhost:3000,127.0.0.1:8000,127.0.0.1:3000

# React frontend origin for CORS (credentialed requests).
FRONTEND_URL=http://localhost:3000

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="mar.elitee@gmail.com"
# Gmail App Password (not the account login password) — generate a new one
# at myaccount.google.com/apppasswords if this ever needs to be rotated.
MAIL_PASSWORD="yvplfcdxpczvhslt"
MAIL_FROM_ADDRESS="mar.elitee@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Send the visitor a confirmation email once an employee accepts.
MEETING_REQUESTS_NOTIFY_CUSTOMER=true
# Public form submissions per minute per IP.
MEETING_REQUESTS_RATE_LIMIT=5

# ── Zoom (optional) — auto-creates a real meeting on acceptance ──────
# Server-to-Server OAuth app at marketplace.zoom.us (scope: meeting:write:admin).
# Leave blank to skip: staff paste a link manually instead.
ZOOM_ACCOUNT_ID=EM6jkNEwQA-rF9nN-Uy6dQ
ZOOM_CLIENT_ID=D47LSgncRDCfn9yjDqV9RA
ZOOM_CLIENT_SECRET=HRRM3eOAuMXMuclDbvmEiYKJ7Kz8p2Qm

# ── Odoo (optional) — syncs new requests as CRM leads ────────────────
# Off by default. Set ODOO_ENABLED=true once these four are filled in.
ODOO_ENABLED=false
ODOO_URL=
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_API_KEY=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
